# SiYuan kernel HTTP API base URL.
GETY_CONFIG_API_URL=http://localhost:6806

# SiYuan API token. Get it from: Settings > About > API token.
GETY_CONFIG_API_TOKEN=

# Optional: absolute path to a debug log file. Disabled when empty.
# Set it only while troubleshooting; the log may contain notebook names.
# Windows: C:\Users\you\siyuan-connector-debug.log
# macOS/Linux: /tmp/siyuan-connector-debug.log
SIYUAN_CONNECTOR_DEBUG_LOG=
